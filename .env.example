# ── Recruitment backend (ERP) ────────────────────────────────────────────
# Origin of the recruitment backend — the Postman collection's `baseUrl`.
# Leave it unset to run against the bundled mock in src/app/api/applicant.
NEXT_PUBLIC_API_URL=https://careers.shunkhlai.mn
# The collection's `originUrl`; sent as the Origin header on server-side calls.
NEXT_PUBLIC_ORIGIN_URL=https://careers.shunkhlai.mn

# ── Clerk (our own auth) ──────────────────────────────────────────────────
# From the Clerk dashboard → API keys. Provide these to enable Clerk login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: route overrides (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (Cloudflare D1) ──────────────────────────────────────────────
# Stores the Clerk-user ↔ ERP link. Accessed over D1's HTTP API in dev.
# From the Cloudflare dashboard / `wrangler d1 create`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
# A D1-scoped API token (Account → D1 → Edit).
CLOUDFLARE_D1_TOKEN=

# ── Secrets encryption ────────────────────────────────────────────────────
# Encrypts regno / phone / ERP tokens at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
