# ── Recruitment backend (ERP) ────────────────────────────────────────────
# Origin of the recruitment backend — the Postman collection's `baseUrl`.
# Leave it unset to run against the bundled mock in src/app/api/applicant.
NEXT_PUBLIC_API_URL=https://careers.shunkhlai.mn
# The collection's `originUrl`; sent as the Origin header on server-side calls.
NEXT_PUBLIC_ORIGIN_URL=https://careers.shunkhlai.mn

# ── Clerk (our own auth) ──────────────────────────────────────────────────
# From the Clerk dashboard → API keys. Provide these to enable Clerk login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: route overrides (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# Everything this app stores: applicant accounts and files, the newsroom, and
# the `app_user` staff table. Server-side only — never NEXT_PUBLIC_*, because
# it carries the password. See docs/postgres.md.
#
# Local development with docker-compose.yml:
#   postgresql://app_user:app_password@localhost:5432/app_db
# The customer's server (password from their IT, never committed):
#   postgresql://app_user:PASSWORD@192.168.2.23:5432/app_db
# Add ?sslmode=require only if that server has TLS; it is off by default.
DATABASE_URL=
# Optional. Connections per instance (default 10).
DATABASE_POOL_MAX=

# ── Cloudflare D1 (retired) ───────────────────────────────────────────────
# Only `bun scripts/db/d1-to-postgres.ts` still reads these — the one-time
# copy out of the old database. The app itself no longer uses D1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
# A D1-scoped API token. Read is enough for the migration script.
CLOUDFLARE_D1_TOKEN=
