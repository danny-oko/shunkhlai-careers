# /etc/systemd/system/shunhlai.service
#
# The careers site as a systemd service: `next start` under a normal user
# account, restarted if it dies, with the filesystem mostly read-only to it.
#
# Install:
#   sudo cp deploy/shunhlai.service /etc/systemd/system/shunhlai.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shunhlai
#   journalctl -u shunhlai -f
#
# UNVERIFIED: written without access to the customer's server. The directives
# below have not been loaded by a running systemd. Before trusting it, run
# `systemd-analyze verify /etc/systemd/system/shunhlai.service` and then
# `systemctl start shunhlai` and read the journal — docs/deploy.md says so too.

[Unit]
Description=Shunkhlai careers site (Next.js)
Documentation=https://github.com/shunkhlai/shunhlai/blob/main/docs/deploy.md
# The app and PostgreSQL are on the same host. `After=` only orders startup, it
# does not wait for Postgres to accept connections — so the app must survive
# starting first. It does: the pool connects lazily on the first query, and
# `/api/health` reports 503 until the database answers.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple

# ── Who ──────────────────────────────────────────────────────────────────────
# A dedicated unprivileged account that owns nothing but the release tree.
# Created once with:
#   sudo adduser --system --group --home /srv/shunhlai --shell /usr/sbin/nologin shunhlai
User=shunhlai
Group=shunhlai

# ── What ─────────────────────────────────────────────────────────────────────
# `current` is a symlink to releases/<timestamp> (see docs/deploy.md). systemd
# resolves it when the service starts, so a release is just re-pointing the
# symlink and restarting — and a rollback is the same move backwards.
WorkingDirectory=/srv/shunhlai/current

# Absolute path: PATH is not what a login shell has, and `npm` alone will not
# be found. Confirm with `command -v npm` on the server; Node 22 from NodeSource
# installs to /usr/bin/npm.
ExecStart=/usr/bin/npm run start

# ── Environment ──────────────────────────────────────────────────────────────
# DATABASE_URL, the Clerk keys, ADMIN_PASSWORD and APP_COMMIT live here — NOT
# in the repository, and not in a file under the web root. The password in
# DATABASE_URL comes from the customer's IT.
#   sudo install -o root -g shunhlai -m 640 -D /dev/null /etc/shunhlai/app.env
# Root-owned and group-readable so the service can read it and the service
# account cannot rewrite it.
EnvironmentFile=/etc/shunhlai/app.env

# Bound to loopback because nginx is the only thing that should reach it; the
# server has no firewall rule standing between port 3000 and the office LAN.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1

# ── Restarting ───────────────────────────────────────────────────────────────
# on-failure, not always: `systemctl stop` during a release must stay stopped.
Restart=on-failure
RestartSec=5
# Five failures in a minute is a broken release, not a blip — stop flapping and
# let the journal show why. `systemctl reset-failed shunhlai` clears it.
StartLimitBurst=5
StartLimitIntervalSec=60

# The server has 1.9 GB of RAM and 6 GB of swap. This is a ceiling that turns
# a runaway process into one killed service rather than a box that has to be
# power-cycled — `next start` serving a prebuilt app sits far below it.
MemoryMax=900M

# ── Hardening ────────────────────────────────────────────────────────────────
# Nothing here is exotic; each line removes a capability this app never uses.
NoNewPrivileges=true
# A private /tmp, so a compromised process cannot read what other services left
# there — and nothing here needs /tmp to be shared.
PrivateTmp=true
# /usr, /boot and /etc become read-only. The app only ever reads them.
ProtectSystem=strict
# /home, /root and /run/user become inaccessible.
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Only the address families the app actually opens: TCP/UDP and unix sockets
# (the Postgres connection may be either, depending on DATABASE_URL).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict makes the whole filesystem read-only, so every path the
# app writes to has to be named back. The leading `-` means "ignore if absent":
# without it, systemd refuses to start the unit when a path does not yet exist,
# which on a first deploy is exactly what happens.
#
# .next/cache — Next.js writes its image-optimisation and fetch caches here at
# runtime. Without it the site still serves, but every optimised image is
# recomputed per request, which on this box is felt.
ReadWritePaths=-/srv/shunhlai/current/.next/cache
# Uploads. NOTE, honestly: today applicant CVs, photos and news media are
# stored in PostgreSQL as chunked rows, not on disk — see docs/postgres.md — so
# this directory is currently unused by the running app. It is named here
# because the brief calls for a writable upload directory and because the first
# change that does write a file to disk should not have to rediscover
# ProtectSystem=strict from a confusing EROFS in production. Create it with:
#   sudo install -d -o shunhlai -g shunhlai -m 750 /srv/shunhlai/shared/uploads
ReadWritePaths=-/srv/shunhlai/shared/uploads

# ── Logs ─────────────────────────────────────────────────────────────────────
# stdout and stderr go to the journal: `journalctl -u shunhlai`. No log file to
# rotate, and nothing writes to the read-only filesystem to produce one.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shunhlai

[Install]
WantedBy=multi-user.target
