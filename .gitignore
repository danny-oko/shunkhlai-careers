# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Mock backend state, written in development only. Holds registered accounts,
# issued tokens and uploaded CVs — local scratch data, never committed.
/.mock-data/

# Uploaded file bytes in development: the default UPLOAD_DIR when the env var
# is unset and NODE_ENV is not production (src/server/files/store.ts). Real CVs
# and photographs if you have ever run against a copy of the customer's data.
# On their server this lives at /var/lib/shunhlai/uploads instead.
/.file-store/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent worktrees. The Agent tool creates these inside the repo, so without
# this they show up as untracked and one `git add .` commits a second full
# copy of the project.
/.claude/worktrees/
